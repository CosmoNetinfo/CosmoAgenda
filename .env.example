# Supabase - Progetto Orbita Agent
# Dati del progetto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tuo-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tuo_anon_key_qui

# Chiave di servizio (OBBLIGATORIA per server MCP e Claude - non arriva mai al client/telefono)
SUPABASE_SERVICE_ROLE_KEY=tuo_service_role_key_qui

# Token segreto per il connettore MCP remoto (/api/mcp/[token])
# Genera un token sicuro con: openssl rand -base64 32
MCP_AUTH_TOKEN=metti-qui-un-token-lungo-e-casuale

# UUID Supabase del proprietario dell'agenda (auth.users.id)
# Necessario perché il server MCP usa la service role key (auth.uid() = null)
# Trovalo in: Supabase Dashboard > Authentication > Users
ORBITA_USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Groq API Key (Opzionale - per la Fase 5: trascrizione Whisper e parsing Llama delle note vocali)
GROQ_API_KEY=

# Personalizzazione del marchio (opzionale)
NEXT_PUBLIC_APP_NAME="Orbita Agent"
NEXT_PUBLIC_BRAND_CLAIM="by Cosmonet"
